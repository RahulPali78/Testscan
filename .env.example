# Local synthetic development only. Do not use these credentials for customer data.
DATABASE_URL=postgresql://veriqo:veriqo_dev@127.0.0.1:5432/veriqo
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=veriqo-foundation
API_HOST=127.0.0.1
API_PORT=4000
VERIQO_API_URL=http://127.0.0.1:4000
FIXTURE_HOST=127.0.0.1
FIXTURE_PORT=4100
FIXTURE_URL=http://127.0.0.1:4100
PORT=3000

# pnpm dev generates these secrets in memory if unset. Never commit real values.
# VERIQO_AUTH_MODE=development
VERIQO_APP_URL=http://127.0.0.1:3000
# VERIQO_DEV_AUTH_SECRET=<random 32+ characters, local only>
# VERIQO_SESSION_SECRET=<random 32+ characters, server only>
# Production identity configuration (no values provisioned by this example):
# VERIQO_AUTH_MODE=oidc
# OIDC_ISSUER=https://your-issuer.example
# OIDC_CLIENT_ID=your-web-client
# OIDC_AUDIENCE=your-api-audience
# OIDC_JWKS_URI=https://your-issuer.example/.well-known/jwks.json
# OIDC_SCOPES=openid profile your-api-scope
# OIDC_CLIENT_SECRET=<only for confidential clients>
